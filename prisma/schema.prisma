generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["multiSchema", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["pubquiz"]
}

model antworten {
  antwort_id        Int              @id @default(autoincrement())
  fragen_id         Int
  antwort           String
  ist_richtig       Boolean          @default(false)
  antworttyp_id     Int
  zusatzinformation String?
  antworttyp        antworttyp       @relation(fields: [antworttyp_id], references: [antworttyp_id], onUpdate: NoAction, map: "fk_antworten_antworttyp")
  fragen            fragen           @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_antworten_fragen")
  medien            medien[]
  team_antworten    team_antworten[]
  team_antwort_auswahlen team_antwort_auswahlen[]

  @@index([fragen_id], map: "idx_antworten_fragen_id")
  @@schema("pubquiz")
}

model antworttyp {
  antworttyp_id Int         @id @default(autoincrement())
  antworttyp    String      @unique
  antworten     antworten[]

  @@schema("pubquiz")
}

model fragen {
  fragen_id                Int                      @id @default(autoincrement())
  frage                    String
  quelle                   String?
  fragentyp                String?
  schwierigkeitslevel      Decimal?                 @db.Decimal(5, 2)
  erstellungsdatum         DateTime                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  ist_archiviert           Boolean                  @default(false)
  archivierungsgrund       String?
  vorlage_id               Int?
  antworten                antworten[]
  antwortfelder            frage_antwortfelder[]
  vorlage                  frage_vorlagen?          @relation(fields: [vorlage_id], references: [vorlage_id])
  fragen_kategorien        fragen_kategorien[]
  medien                   medien[]
  generator_laefe          medien_generator_laefe[]
  relationen_als_quelle    fragen_relationen[]      @relation("fragen_relation_quelle")
  relationen_als_ziel      fragen_relationen[]      @relation("fragen_relation_ziel")
  quiz_fragen              quiz_fragen[]
  created_by_user_id       Int?
  created_at               DateTime                 @default(now())
  last_modified_by_user_id Int?
  updated_at               DateTime                 @default(now()) @updatedAt
  approved_by_user_id      Int?
  approved_at              DateTime?
  freigegeben              Boolean                  @default(false)
  ist_unfertig             Boolean                  @default(false)
  moderationsnotizen       String?
  kategorienwunsch         String?
  gueltig_bis              DateTime?                @db.Date
  review_status            QuestionReviewStatus     @default(DRAFT)
  submitted_at             DateTime?
  submitted_by_user_id     Int?
  review_feedback          String?
  reviewed_at              DateTime?
  reviewed_by_user_id      Int?
  template_config_json     Json?
  geltungsbereich          QuestionScope            @default(GLOBAL)
  eventreihen              fragen_eventreihen[]

  @@index([created_by_user_id, review_status, ist_archiviert], map: "idx_fragen_eigene_arbeitsliste")
  @@index([review_status, ist_archiviert, submitted_at], map: "idx_fragen_review_queue")
  @@schema("pubquiz")
}

model fragen_relationen {
  fragen_relation_id Int      @id @default(autoincrement())
  quell_fragen_id    Int
  ziel_fragen_id     Int
  antwort_position   Int
  typ                String   @db.VarChar(80)
  ist_aktiv          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt
  quell_frage        fragen   @relation("fragen_relation_quelle", fields: [quell_fragen_id], references: [fragen_id], onDelete: Cascade)
  ziel_frage         fragen   @relation("fragen_relation_ziel", fields: [ziel_fragen_id], references: [fragen_id], onDelete: Cascade)

  @@unique([quell_fragen_id, typ, antwort_position], map: "uq_fragen_relation_quelle_typ_position")
  @@unique([ziel_fragen_id, typ], map: "uq_fragen_relation_ziel_typ")
  @@index([quell_fragen_id, ist_aktiv], map: "idx_fragen_relation_quelle_aktiv")
  @@index([ziel_fragen_id, ist_aktiv], map: "idx_fragen_relation_ziel_aktiv")
  @@schema("pubquiz")
}

model fragen_kategorien {
  fragen_kategorie_zuordnung_id Int             @id @default(autoincrement())
  fragen_id                     Int
  fragenkategorie_id            Int
  fragen                        fragen          @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fragen_kategorien_fragen")
  fragenkategorie               fragenkategorie @relation(fields: [fragenkategorie_id], references: [fragenkategorie_id], onUpdate: NoAction, map: "fk_fragen_kategorien_kategorie")

  @@unique([fragen_id, fragenkategorie_id], map: "uq_fragen_kategorien")
  @@index([fragen_id], map: "idx_fragen_kategorien_fragen_id")
  @@index([fragenkategorie_id], map: "idx_fragen_kategorien_kategorie_id")
  @@schema("pubquiz")
}

model fragenkategorie {
  fragenkategorie_id Int                 @id @default(autoincrement())
  kategorie          String              @unique
  status             CategoryStatus      @default(ACTIVE)
  created_by_user_id Int?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  fragen_kategorien  fragen_kategorien[]
  created_by         users?              @relation("CategoryCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([status, kategorie], map: "idx_fragenkategorie_status_name")
  @@index([created_by_user_id], map: "idx_fragenkategorie_created_by")
  @@schema("pubquiz")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model medien {
  medien_id             Int                            @id @default(autoincrement())
  fragen_id             Int?
  antwort_id            Int?
  medientyp_id          Int
  datei                 String
  sortierung            Int                            @default(1)
  bemerkung             String?
  antwortfeld_id        Int?
  slot_key              String?                        @db.VarChar(80)
  antworten             antworten?                     @relation(fields: [antwort_id], references: [antwort_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medien_antworten")
  fragen                fragen?                        @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medien_fragen")
  medientyp             medientyp                      @relation(fields: [medientyp_id], references: [medientyp_id], onUpdate: NoAction, map: "fk_medien_medientyp")
  antwortfeld           frage_antwortfelder?           @relation(fields: [antwortfeld_id], references: [antwortfeld_id], onDelete: Cascade)
  generator_lauf_medien medien_generator_lauf_medien[]

  @@index([antwort_id], map: "idx_medien_antwort_id")
  @@index([fragen_id], map: "idx_medien_fragen_id")
  @@index([fragen_id, slot_key], map: "idx_medien_fragen_slot")
  @@index([antwort_id, slot_key], map: "idx_medien_antwort_slot")
  @@index([antwortfeld_id, slot_key], map: "idx_medien_antwortfeld_slot")
  @@index([antwortfeld_id], map: "idx_medien_antwortfeld_id")
  @@index([antwortfeld_id, sortierung], map: "idx_medien_sortierung_antwortfeld", where: raw("(antwortfeld_id IS NOT NULL)"))
  @@index([antwort_id, sortierung], map: "idx_medien_sortierung_antwort", where: raw("(antwort_id IS NOT NULL)"))
  @@index([fragen_id, sortierung], map: "idx_medien_sortierung_frage", where: raw("(fragen_id IS NOT NULL)"))
  @@schema("pubquiz")
}

model medien_generator_laefe {
  generator_lauf_id Int                            @id @default(autoincrement())
  fragen_id         Int
  generator_id      String                         @db.VarChar(80)
  generator_version Int
  status            String                         @db.VarChar(20)
  input_fingerprint String?                        @db.VarChar(64)
  error_code        String?                        @db.VarChar(80)
  error_message     String?
  parameters_json   Json?
  started_at        DateTime?
  finished_at       DateTime?
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @default(now()) @updatedAt
  fragen            fragen                         @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade)
  medien            medien_generator_lauf_medien[]

  @@unique([fragen_id, generator_id], map: "uq_generator_lauf_active", where: raw("(status IN ('PENDING', 'PROCESSING'))"))
  @@index([fragen_id, generator_id, created_at], map: "idx_generator_laefe_frage_generator")
  @@index([fragen_id, generator_id, input_fingerprint], map: "idx_generator_laefe_fingerprint")
  @@index([status, updated_at], map: "idx_generator_laefe_status")
  @@schema("pubquiz")
}

model medien_generator_lauf_medien {
  generator_lauf_medium_id Int                    @id @default(autoincrement())
  generator_lauf_id        Int
  medien_id                Int
  rolle                    String                 @db.VarChar(10)
  slot_key                 String                 @db.VarChar(80)
  created_at               DateTime               @default(now())
  generator_lauf           medien_generator_laefe @relation(fields: [generator_lauf_id], references: [generator_lauf_id], onDelete: Cascade)
  medium                   medien                 @relation(fields: [medien_id], references: [medien_id], onDelete: Cascade)

  @@unique([generator_lauf_id, medien_id, rolle], map: "uq_generator_lauf_medium_rolle")
  @@index([medien_id, rolle], map: "idx_generator_lauf_medien_medium")
  @@index([generator_lauf_id, rolle], map: "idx_generator_lauf_medien_lauf")
  @@schema("pubquiz")
}

model medientyp {
  medientyp_id Int      @id @default(autoincrement())
  medientyp    String   @unique
  medien       medien[]

  @@schema("pubquiz")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz {
  quiz_id                  Int                        @id @default(autoincrement())
  eventreihe_id            Int
  quiz_datum               DateTime?                  @db.Date
  titel                    String?
  veranstaltungszeit       String?                    @db.VarChar(5)
  veranstaltungsname       String?                    @db.VarChar(200)
  karten_url               String?                    @db.VarChar(2048)
  oeffentliche_url         String?                    @db.VarChar(2048)
  team_anzahl              Int?
  teilnehmer_anzahl        Int?
  bemerkung                String?
  ist_archiviert           Boolean                    @default(false)
  archivierungsgrund       String?
  intro_begruessungstext   String?
  intro_begruessungstitel  String?
  intro_logo_url           String?
  intro_musik_url          String?
  intro_preise             String?
  intro_regeln             String?
  intro_wartetext          String?
  intro_startsequenz_text  String?
  intro_startzeit          String?
  intro_video_url          String?
  outro_bekanntmachungen   String?
  manuelle_bewertungen     Int?                       @default(0)
  presentation_template_id String?                    @db.VarChar(64)
  answer_form_template_id  String?                    @db.VarChar(64)
  quiz_abschnitte          quiz_abschnitte[]
  quiz_block_freigaben     quiz_block_freigaben[]
  quiz_fragen              quiz_fragen[]
  praesentation_status     quiz_praesentation_status?
  quiz_team_sessions       quiz_team_sessions[]
  quiz_teams               quiz_teams[]
  team_antworten           team_antworten[]
  eventreihe               eventreihen                @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Restrict)

  @@index([eventreihe_id], map: "idx_quiz_eventreihe_id")
  @@schema("pubquiz")
}

model eventreihen {
  eventreihe_id                    Int                          @id @default(autoincrement())
  name                             String                       @db.VarChar(150)
  slug                             String                       @unique @db.VarChar(180)
  oeffentlicher_name               String?                      @db.VarChar(150)
  beschreibung                     String?                      @db.VarChar(2000)
  interne_bemerkung                String?                      @db.VarChar(2000)
  ist_oeffentlich                  Boolean                      @default(false)
  ist_archiviert                   Boolean                      @default(false)
  archiviert_am                    DateTime?
  created_at                       DateTime                     @default(now())
  updated_at                       DateTime                     @default(now()) @updatedAt
  default_presentation_template_id String                       @default("ungegoogelt-default") @db.VarChar(64)
  default_answer_form_template_id  String                       @default("ungegoogelt-default") @db.VarChar(64)
  quiz                             quiz[]
  benutzerrollen                   eventreihe_benutzerrollen[]
  rollenzuweisungen                benutzer_rollenzuweisungen[]
  fragen                           fragen_eventreihen[]

  @@index([ist_archiviert, name], map: "idx_eventreihen_status_name")
  @@schema("pubquiz")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz_fragen {
  quiz_fragen_id                Int              @id @default(autoincrement())
  quiz_id                       Int
  fragen_id                     Int
  sortierung                    Int?
  richtigeantworten             Int?             @default(0)
  falscheantworten              Int?             @default(0)
  antwort_reihenfolge           Int[]            @default([])
  praesentationslayout          String?          @default("standard")
  quiz_abschnitt_id             Int?
  punkte_basis                  Decimal          @default(1)
  punkte_modus                  String           @default("standard")
  risiko_pool_teamanzahl        Int?
  risiko_pool_fixiert_am        DateTime?
  freie_antwort_erlaubt         Boolean          @default(false)
  praesentationsdauer_messungen Int?             @default(0)
  praesentationsdauer_sekunden  Int?
  fragen                        fragen           @relation(fields: [fragen_id], references: [fragen_id], onUpdate: NoAction, map: "fk_quiz_fragen_fragen")
  quiz                          quiz             @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_fragen_quiz")
  quiz_abschnitte               quiz_abschnitte? @relation(fields: [quiz_abschnitt_id], references: [quiz_abschnitt_id])
  team_antworten                team_antworten[]

  @@unique([quiz_id, fragen_id], map: "uq_quiz_fragen")
  @@unique([quiz_id, sortierung], map: "uq_quiz_fragen_sortierung")
  @@index([quiz_id], map: "idx_quiz_fragen_quiz_id")
  @@schema("pubquiz")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz_teams {
  quiz_team_id Int      @id @default(autoincrement())
  quiz_id      Int
  team_id      Int
  punkte       Decimal? @db.Decimal(6, 2)
  platzierung  Int?
  quiz         quiz     @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_teams_quiz")
  teams        teams    @relation(fields: [team_id], references: [team_id], onUpdate: NoAction, map: "fk_quiz_teams_teams")

  @@unique([quiz_id, team_id], map: "uq_quiz_teams")
  @@index([quiz_id], map: "idx_quiz_teams_quiz_id")
  @@schema("pubquiz")
}

model teams {
  team_id       Int          @id @default(autoincrement())
  teamname      String       @unique
  team_passwort String?
  quiz_teams    quiz_teams[]

  @@schema("pubquiz")
}

model quiz_abschnitte {
  quiz_abschnitt_id    Int                    @id @default(autoincrement())
  quiz_id              Int
  titel                String
  abschnitt_typ        String
  sortierung           Int
  dauer_sekunden       Int?
  qr_code_url          String?
  medien_datei         String?
  bemerkung            String?
  quiz                 quiz                   @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  quiz_block_freigaben quiz_block_freigaben[]
  quiz_fragen          quiz_fragen[]
  team_antworten       team_antworten[]

  @@schema("pubquiz")
}

model quiz_team_sessions {
  quiz_team_session_id Int              @id @default(autoincrement())
  quiz_id              Int
  teamname             String
  erstellt_am          DateTime         @default(now())
  spieler_anzahl       Int              @default(1)
  quiz                 quiz             @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  team_antworten       team_antworten[]

  @@unique([quiz_id, teamname], map: "uq_quiz_team_session_teamname")
  @@schema("pubquiz")
}

model quiz_block_freigaben {
  quiz_block_freigabe_id  Int             @id @default(autoincrement())
  quiz_id                 Int
  quiz_abschnitt_id       Int
  ist_freigegeben         Boolean         @default(false)
  ist_geschlossen         Boolean         @default(false)
  freigegeben_ab          DateTime?
  geschlossen_ab          DateTime?
  aktuelle_quiz_fragen_id Int?
  quiz_abschnitte         quiz_abschnitte @relation(fields: [quiz_abschnitt_id], references: [quiz_abschnitt_id], onDelete: Cascade)
  quiz                    quiz            @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)

  @@unique([quiz_id, quiz_abschnitt_id], map: "uq_quiz_block_freigabe")
  @@schema("pubquiz")
}

model team_antworten {
  team_antwort_id      Int                  @id @default(autoincrement())
  quiz_id              Int
  quiz_abschnitt_id    Int
  quiz_fragen_id       Int
  quiz_team_session_id Int
  antwort_text         String?
  antwort_id           Int?
  aktualisiert_am      DateTime             @default(now())
  bewertete_antwort    String?
  bewertung_final      Boolean              @default(false)
  ist_manuell_falsch   Boolean              @default(false)
  ist_manuell_richtig  Boolean              @default(false)
  ist_skurril          Boolean              @default(false)
  auto_basis_punkte    Decimal              @default(0) @db.Decimal(12, 4)
  auto_endpunkte       Decimal              @default(0) @db.Decimal(12, 4)
  vergebene_punkte     Decimal              @default(0) @db.Decimal(12, 4)
  bewertungsstatus     QuizAnswerEvaluationStatus @default(UNANSWERED)
  bewertungsquelle     QuizAnswerEvaluationSource @default(LEGACY)
  bewertungsdetails    Json?
  bewertungs_version    Int                  @default(0)
  manuelle_punkte      Decimal?             @db.Decimal(12, 4)
  bewertet_am          DateTime?
  bewertet_von_user_id Int?
  antworten            antworten?           @relation(fields: [antwort_id], references: [antwort_id])
  quiz_abschnitte      quiz_abschnitte      @relation(fields: [quiz_abschnitt_id], references: [quiz_abschnitt_id], onDelete: Cascade)
  quiz_fragen          quiz_fragen          @relation(fields: [quiz_fragen_id], references: [quiz_fragen_id], onDelete: Cascade)
  quiz                 quiz                 @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  quiz_team_sessions   quiz_team_sessions   @relation(fields: [quiz_team_session_id], references: [quiz_team_session_id], onDelete: Cascade)
  antwortfelder        team_antwortfelder[]
  antwortauswahlen     team_antwort_auswahlen[]
  bewertet_von         users?               @relation("TeamAnswerEvaluator", fields: [bewertet_von_user_id], references: [id], onDelete: SetNull)

  @@unique([quiz_fragen_id, quiz_team_session_id], map: "uq_team_antwort_pro_frage")
  @@schema("pubquiz")
}

model frage_antwortfelder {
  antwortfeld_id Int                           @id @default(autoincrement())
  fragen_id      Int
  label          String
  sortierung     Int
  ist_pflicht    Boolean                       @default(true)
  loesungen      frage_antwortfeld_loesungen[]
  frage          fragen                        @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade)
  medien         medien[]
  team_antworten team_antwortfelder[]

  @@schema("pubquiz")
}

model team_antwortfelder {
  team_antwortfeld_id Int                 @id @default(autoincrement())
  team_antwort_id     Int
  antwortfeld_id      Int
  antwort_text        String?
  antwortfeld         frage_antwortfelder @relation(fields: [antwortfeld_id], references: [antwortfeld_id], onDelete: Cascade)
  team_antwort        team_antworten      @relation(fields: [team_antwort_id], references: [team_antwort_id], onDelete: Cascade)

  @@unique([team_antwort_id, antwortfeld_id], map: "uq_team_antwortfeld")
  @@schema("pubquiz")
}

model frage_antwortfeld_loesungen {
  loesung_id        Int                 @id @default(autoincrement())
  antwortfeld_id    Int
  loesung_text      String
  sortierung        Int
  ist_akzeptiert    Boolean             @default(true)
  zusatzinformation String?
  antwortfeld       frage_antwortfelder @relation(fields: [antwortfeld_id], references: [antwortfeld_id], onDelete: Cascade)

  @@schema("pubquiz")
}

model frage_vorlagen {
  vorlage_id    Int                           @id @default(autoincrement())
  code          String                        @unique
  name          String
  slide_typ     String
  ist_aktiv     Boolean                       @default(true)
  antwortfelder frage_vorlage_antwortfelder[]
  fragen        fragen[]

  @@schema("pubquiz")
}

model frage_vorlage_antwortfelder {
  vorlage_antwortfeld_id Int            @id @default(autoincrement())
  vorlage_id             Int
  label                  String
  sortierung             Int
  ist_pflicht            Boolean        @default(true)
  vorlage                frage_vorlagen @relation(fields: [vorlage_id], references: [vorlage_id], onDelete: Cascade)

  @@schema("pubquiz")
}

model quiz_praesentation_status {
  quiz_id                  Int       @id
  slide_index              Int       @default(0)
  slide_started_at         DateTime  @default(now())
  quiz_started_at          DateTime?
  updated_at               DateTime  @updatedAt
  audio_aktion             String?
  audio_aktion_id          Int       @default(0)
  countdown_dauer_sekunden Int?
  countdown_ended_at       DateTime?
  countdown_started_at     DateTime?
  countdown_status         String?
  medium_overlay_aktiv     Boolean   @default(false)
  endstand_reveal_count    Int       @default(0)
  show_schaetzfrage        Boolean   @default(false)
  zeige_schaetzantwort     Boolean   @default(false)
  schaetzfrage_id          Int?
  quiz                     quiz      @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)

  @@schema("pubquiz")
}

enum UserRole {
  USER
  EDITOR
  ADMIN

  @@schema("pubquiz")
}

enum EventSeriesRole {
  EVENT_MANAGER
  EVENT_EDITOR

  @@schema("pubquiz")
}

enum RoleAssignmentRole {
  ADMIN
  EDITOR
  EVENT_MANAGER

  @@schema("pubquiz")
}

enum RoleScopeType {
  GLOBAL
  EVENT_SERIES

  @@schema("pubquiz")
}

enum QuestionScope {
  GLOBAL
  EVENT_SERIES

  @@schema("pubquiz")
}

enum QuestionReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED

  @@schema("pubquiz")
}

model team_antwort_auswahlen {
  team_antwort_id Int
  antwort_id      Int
  team_antwort    team_antworten @relation(fields: [team_antwort_id], references: [team_antwort_id], onDelete: Cascade)
  antwort         antworten      @relation(fields: [antwort_id], references: [antwort_id], onDelete: Cascade)

  @@id([team_antwort_id, antwort_id])
  @@schema("pubquiz")
}

enum CategoryStatus {
  ACTIVE
  PENDING
  ARCHIVED

  @@schema("pubquiz")
}

enum QuizAnswerEvaluationStatus {
  UNANSWERED
  WRONG
  PARTIAL
  CORRECT
  REVIEW_REQUIRED

  @@schema("pubquiz")
}

enum QuizAnswerEvaluationSource {
  AUTO
  MANUAL
  LEGACY

  @@schema("pubquiz")
}

model users {
  id Int @id @default(autoincrement())

  // Persönliche Daten
  name       String?
  email      String  @unique
  avatar_url String?

  // Authentifizierung
  password_hash String
  role          UserRole @default(EDITOR)
  is_active     Boolean  @default(true)

  must_change_password Boolean @default(false)

  // Audit
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eventreihenrollen             eventreihe_benutzerrollen[]  @relation("EventSeriesMembershipUser")
  zugewiesene_eventreihenrollen eventreihe_benutzerrollen[]  @relation("EventSeriesMembershipAssigner")
  rollenzuweisungen             benutzer_rollenzuweisungen[] @relation("RoleAssignmentUser")
  zugewiesene_rollen            benutzer_rollenzuweisungen[] @relation("RoleAssignmentAssigner")
  erstellte_kategorien          fragenkategorie[]             @relation("CategoryCreator")
  bewertete_team_antworten      team_antworten[]               @relation("TeamAnswerEvaluator")

  @@schema("pubquiz")
}

/// Role/scope validity is additionally enforced by database check constraints in the migration.
model benutzer_rollenzuweisungen {
  rollenzuweisung_id     Int                @id @default(autoincrement())
  benutzer_id            Int
  rolle                  RoleAssignmentRole
  scope_typ              RoleScopeType
  eventreihe_id          Int?
  zugewiesen_von_user_id Int?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @default(now()) @updatedAt
  benutzer               users              @relation("RoleAssignmentUser", fields: [benutzer_id], references: [id], onDelete: Cascade)
  eventreihe             eventreihen?       @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Cascade)
  zugewiesen_von         users?             @relation("RoleAssignmentAssigner", fields: [zugewiesen_von_user_id], references: [id], onDelete: SetNull)

  @@unique([benutzer_id, rolle], map: "uq_rollenzuweisung_global", where: raw("(scope_typ = 'GLOBAL'::\"pubquiz\".\"RoleScopeType\")"))
  @@unique([benutzer_id, eventreihe_id], map: "uq_rollenzuweisung_eventreihe", where: raw("(scope_typ = 'EVENT_SERIES'::\"pubquiz\".\"RoleScopeType\")"))
  @@index([benutzer_id], map: "idx_rollenzuweisungen_benutzer")
  @@index([eventreihe_id], map: "idx_rollenzuweisungen_eventreihe")
  @@schema("pubquiz")
}

model eventreihe_benutzerrollen {
  eventreihe_benutzerrolle_id Int             @id @default(autoincrement())
  eventreihe_id               Int
  benutzer_id                 Int
  rolle                       EventSeriesRole
  zugewiesen_von_user_id      Int?
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @default(now()) @updatedAt
  eventreihe                  eventreihen     @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Cascade)
  benutzer                    users           @relation("EventSeriesMembershipUser", fields: [benutzer_id], references: [id], onDelete: Cascade)
  zugewiesen_von              users?          @relation("EventSeriesMembershipAssigner", fields: [zugewiesen_von_user_id], references: [id], onDelete: SetNull)

  @@unique([benutzer_id, eventreihe_id], map: "uq_eventreihe_benutzerrolle_benutzer_eventreihe")
  @@index([benutzer_id], map: "idx_eventreihe_benutzerrollen_benutzer")
  @@index([eventreihe_id], map: "idx_eventreihe_benutzerrollen_eventreihe")
  @@schema("pubquiz")
}

model fragen_eventreihen {
  fragen_eventreihe_id Int         @id @default(autoincrement())
  fragen_id            Int
  eventreihe_id        Int
  created_at           DateTime    @default(now())
  frage                fragen      @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade)
  eventreihe           eventreihen @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Restrict)

  @@unique([fragen_id, eventreihe_id], map: "uq_fragen_eventreihen_frage_eventreihe")
  @@index([fragen_id], map: "idx_fragen_eventreihen_frage")
  @@index([eventreihe_id], map: "idx_fragen_eventreihen_eventreihe")
  @@schema("pubquiz")
}
