model team_antworten {
  team_antwort_id      Int                        @id @default(autoincrement())
  quiz_id              Int
  quiz_abschnitt_id    Int
  quiz_fragen_id       Int
  quiz_team_session_id Int
  antwort_text         String?
  antwort_id           Int?
  aktualisiert_am      DateTime                   @default(now())
  bewertete_antwort    String?
  bewertung_final      Boolean                    @default(false)
  ist_manuell_falsch   Boolean                    @default(false)
  ist_manuell_richtig  Boolean                    @default(false)
  ist_skurril          Boolean                    @default(false)
  auto_basis_punkte    Decimal                    @default(0) @db.Decimal(12, 4)
  auto_endpunkte       Decimal                    @default(0) @db.Decimal(12, 4)
  vergebene_punkte     Decimal                    @default(0) @db.Decimal(12, 4)
  bewertungsstatus     QuizAnswerEvaluationStatus @default(UNANSWERED)
  bewertungsquelle     QuizAnswerEvaluationSource @default(LEGACY)
  bewertungsdetails    Json?
  bewertungs_version   Int                        @default(0)
  manuelle_punkte      Decimal?                   @db.Decimal(12, 4)
  bewertet_am          DateTime?
  bewertet_von_user_id Int?
  interaction_run_id   Int?
  draft_revision       Int                        @default(0)
  draft_updated_at     DateTime?
  antworten            antworten?                 @relation(fields: [antwort_id], references: [antwort_id])
  quiz_abschnitte      quiz_abschnitte            @relation(fields: [quiz_abschnitt_id], references: [quiz_abschnitt_id], onDelete: Cascade)
  quiz_fragen          quiz_fragen                @relation(fields: [quiz_fragen_id], references: [quiz_fragen_id], onDelete: Cascade)
  quiz                 quiz                       @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  quiz_team_sessions   quiz_team_sessions         @relation(fields: [quiz_team_session_id], references: [quiz_team_session_id], onDelete: Cascade)
  antwortfelder        team_antwortfelder[]
  antwortauswahlen     team_antwort_auswahlen[]
  bewertet_von         users?                     @relation("TeamAnswerEvaluator", fields: [bewertet_von_user_id], references: [id], onDelete: SetNull)
  interaction_run      quiz_interaction_runs?     @relation(fields: [interaction_run_id], references: [interaction_run_id], onDelete: SetNull)
  submissions          team_answer_submissions[]

  @@unique([quiz_fragen_id, quiz_team_session_id], map: "uq_team_antwort_pro_frage")
  @@index([interaction_run_id, quiz_team_session_id], map: "idx_team_antworten_interaction_team")
  @@schema("pubquiz")
}

model quiz_interaction_runs {
  interaction_run_id         Int                       @id @default(autoincrement())
  quiz_id                    Int
  quiz_fragen_id             Int?
  quiz_ablauf_element_id     Int?
  interaction_type           String                    @db.VarChar(32)
  state                      QuizInteractionState      @default(LOCKED)
  is_current                 Boolean                   @default(false)
  opened_at                  DateTime?
  deadline_at                DateTime?
  stopped_by_team_session_id Int?
  stopped_at                 DateTime?
  stopped_at_stage           Int?
  closed_at                  DateTime?
  revealed_at                DateTime?
  revision                   Int                       @default(0)
  config_snapshot            Json
  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @default(now()) @updatedAt
  quiz                       quiz                      @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  quiz_fragen                quiz_fragen?              @relation(fields: [quiz_fragen_id], references: [quiz_fragen_id], onDelete: Cascade)
  quiz_ablauf_elemente       quiz_ablauf_elemente?     @relation(fields: [quiz_ablauf_element_id], references: [quiz_ablauf_element_id], onDelete: Cascade)
  stopped_by_team_session    quiz_team_sessions?       @relation("PixelStopper", fields: [stopped_by_team_session_id], references: [quiz_team_session_id], onDelete: SetNull)
  team_antworten             team_antworten[]
  answer_submissions         team_answer_submissions[]

  @@unique([quiz_id], map: "uq_quiz_interaction_runs_current", where: raw("(is_current = true)"))
  @@index([quiz_id, created_at], map: "idx_quiz_interaction_runs_quiz_created")
  @@index([quiz_fragen_id], map: "idx_quiz_interaction_runs_question")
  @@index([stopped_by_team_session_id], map: "idx_quiz_interaction_runs_pixel_stopper")
  @@schema("pubquiz")
}

model team_answer_submissions {
  team_answer_submission_id Int                        @id @default(autoincrement())
  interaction_run_id        Int
  team_antwort_id           Int
  quiz_team_session_id      Int
  submission_version        Int                        @default(1)
  status                    TeamAnswerSubmissionStatus
  interaction_type          String                     @db.VarChar(32)
  payload                   Json
  draft_revision            Int
  submitted_at              DateTime                   @default(now())
  finalization_reason       String?                    @db.VarChar(64)
  interaction_run           quiz_interaction_runs      @relation(fields: [interaction_run_id], references: [interaction_run_id], onDelete: Cascade)
  team_antwort              team_antworten             @relation(fields: [team_antwort_id], references: [team_antwort_id], onDelete: Cascade)
  quiz_team_session         quiz_team_sessions         @relation(fields: [quiz_team_session_id], references: [quiz_team_session_id], onDelete: Cascade)

  @@unique([interaction_run_id, quiz_team_session_id, submission_version], map: "uq_team_answer_submission_run_team_version")
  @@unique([interaction_run_id, quiz_team_session_id, draft_revision], map: "uq_team_answer_submission_run_team_draft")
  @@index([team_antwort_id], map: "idx_team_answer_submissions_answer")
  @@index([interaction_run_id, quiz_team_session_id, submitted_at], map: "idx_team_answer_submissions_run_team_time")
  @@index([quiz_team_session_id, submitted_at], map: "idx_team_answer_submissions_team_time")
  @@schema("pubquiz")
}

model frage_antwortfelder {
