model users {
  id Int @id @default(autoincrement())

  // Persönliche Daten
  name       String?
  email      String  @unique
  avatar_url String?

  // Authentifizierung
  password_hash String
  role          UserRole @default(EDITOR)
  is_active     Boolean  @default(true)

  must_change_password Boolean @default(false)

  // Audit
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eventreihenrollen                 eventreihe_benutzerrollen[]  @relation("EventSeriesMembershipUser")
  zugewiesene_eventreihenrollen     eventreihe_benutzerrollen[]  @relation("EventSeriesMembershipAssigner")
  rollenzuweisungen                 benutzer_rollenzuweisungen[] @relation("RoleAssignmentUser")
  zugewiesene_rollen                benutzer_rollenzuweisungen[] @relation("RoleAssignmentAssigner")
  erstellte_kategorien              fragenkategorie[]            @relation("CategoryCreator")
  bewertete_team_antworten          team_antworten[]             @relation("TeamAnswerEvaluator")
  erstellte_praesentationstemplates presentation_templates[]     @relation("PresentationTemplateCreator")
  erstellte_story_elemente          story_elemente[]             @relation("StoryElementCreator")
  erstellte_story_revisionen        story_element_revisionen[]   @relation("StoryElementRevisionCreator")
  erstellte_story_verknuepfungen    frage_story_elemente[]       @relation("StoryQuestionLinkCreator")
  erstellte_fragevorlagen           frage_vorlagen[]             @relation("QuestionTemplateCreator")
  bewertete_fragevorlagen           frage_vorlagen[]             @relation("QuestionTemplateReviewer")
  aktualitaet_gepruefte_fragen      fragen[]                      @relation("QuestionFreshnessReviewer")

  @@schema("pubquiz")
}

/// Role/scope validity is additionally enforced by database check constraints in the migration.
model benutzer_rollenzuweisungen {
  rollenzuweisung_id     Int                @id @default(autoincrement())
  benutzer_id            Int
  rolle                  RoleAssignmentRole
  scope_typ              RoleScopeType
  eventreihe_id          Int?
  zugewiesen_von_user_id Int?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @default(now()) @updatedAt
  benutzer               users              @relation("RoleAssignmentUser", fields: [benutzer_id], references: [id], onDelete: Cascade)
  eventreihe             eventreihen?       @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Cascade)
  zugewiesen_von         users?             @relation("RoleAssignmentAssigner", fields: [zugewiesen_von_user_id], references: [id], onDelete: SetNull)

  @@unique([benutzer_id, rolle], map: "uq_rollenzuweisung_global", where: raw("(scope_typ = 'GLOBAL'::\"pubquiz\".\"RoleScopeType\")"))
  @@unique([benutzer_id, eventreihe_id], map: "uq_rollenzuweisung_eventreihe", where: raw("(scope_typ = 'EVENT_SERIES'::\"pubquiz\".\"RoleScopeType\")"))
  @@index([benutzer_id], map: "idx_rollenzuweisungen_benutzer")
  @@index([eventreihe_id], map: "idx_rollenzuweisungen_eventreihe")
  @@schema("pubquiz")
}

model eventreihe_benutzerrollen {
  eventreihe_benutzerrolle_id Int             @id @default(autoincrement())
  eventreihe_id               Int
  benutzer_id                 Int
  rolle                       EventSeriesRole
  zugewiesen_von_user_id      Int?
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @default(now()) @updatedAt
  eventreihe                  eventreihen     @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Cascade)
  benutzer                    users           @relation("EventSeriesMembershipUser", fields: [benutzer_id], references: [id], onDelete: Cascade)
  zugewiesen_von              users?          @relation("EventSeriesMembershipAssigner", fields: [zugewiesen_von_user_id], references: [id], onDelete: SetNull)

  @@unique([benutzer_id, eventreihe_id], map: "uq_eventreihe_benutzerrolle_benutzer_eventreihe")
  @@index([benutzer_id], map: "idx_eventreihe_benutzerrollen_benutzer")
  @@index([eventreihe_id], map: "idx_eventreihe_benutzerrollen_eventreihe")
  @@schema("pubquiz")
}

model fragen_eventreihen {
  fragen_eventreihe_id Int         @id @default(autoincrement())
  fragen_id            Int
  eventreihe_id        Int
  created_at           DateTime    @default(now())
  frage                fragen      @relation(fields: [fragen_id], references: [fragen_id], onDelete: Cascade)
  eventreihe           eventreihen @relation(fields: [eventreihe_id], references: [eventreihe_id], onDelete: Restrict)

  @@unique([fragen_id, eventreihe_id], map: "uq_fragen_eventreihen_frage_eventreihe")
  @@index([fragen_id], map: "idx_fragen_eventreihen_frage")
  @@index([eventreihe_id], map: "idx_fragen_eventreihen_eventreihe")
  @@schema("pubquiz")
}
