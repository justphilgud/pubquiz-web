# Copy this file to .env.development.local for local development.
# .env.development.local is the only authoritative local environment file.
# Never commit real values.

# Neon branch: pubquiz-dev
DATABASE_URL=<required-neon-pubquiz-dev-connection>
# Optional exact guard value; local startup aborts if DATABASE_URL uses this host.
PRODUCTION_DATABASE_HOST=<optional-production-neon-hostname>

# Auth.js: use a stable, local-only secret (NEXTAUTH_SECRET is an allowed alias).
AUTH_SECRET=<required-unique-local-secret>
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Non-secret client label; never used for server authorization or routing.
NEXT_PUBLIC_APP_ENV=development

# Explicit server environment override for controlled local runs.
MEDIA_UPLOAD_ENV=development

# Vercel Blob store: pubquiz-media-nonprod
# All upload routes use this fixed credential explicitly. Local code never uses OIDC.
BLOB_READ_WRITE_TOKEN=<required-nonprod-read-write-token>
BLOB_WEBHOOK_PUBLIC_KEY=<required-nonprod-webhook-public-key>

# Optional callback override used by the active legacy client upload route.
VERCEL_BLOB_CALLBACK_URL=<optional-local-callback-base-url>
