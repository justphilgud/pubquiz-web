# Local Development only. Copy names to an ignored local env file.
# Never commit real values.

# Neon branch: pubquiz-dev
DATABASE_URL=<required-neon-pubquiz-dev-connection>

# Auth.js
AUTH_SECRET=<required-unique-local-secret>
AUTH_TRUST_HOST=<optional-local-host-trust>
AUTH_URL=<optional-local-canonical-url>

# Protected quiz/show routes
AUSWERTUNG_PASSWORT=<required-local-password>

# Non-secret label embedded in the client build
NEXT_PUBLIC_APP_ENV=<optional-development-label>

# Vercel Blob store: pubquiz-media-nonprod
# The legacy client-token route still requires a read/write token.
BLOB_READ_WRITE_TOKEN=<required-for-legacy-upload-route>
# OIDC is an optional, short-lived local alternative for supported routes.
VERCEL_OIDC_TOKEN=<optional-short-lived-local-oidc-token>
BLOB_STORE_ID=<required-when-using-oidc>
BLOB_WEBHOOK_PUBLIC_KEY=<required-question-upload-public-key>

# Optional outside Vercel; allowed logical values are documented in
# docs/architecture/environments.md.
MEDIA_UPLOAD_ENV=<optional-local-media-environment>

# Optional callback override used by the legacy Blob client upload.
VERCEL_BLOB_CALLBACK_URL=<optional-local-callback-base-url>
